@model IEnumerable<Group>
<div class="groups">
    @foreach(var item in Model)
    {
        <a asp-controller="chip" asp-action="ContentsOfGroup" asp-route-id="@item.Id">
        <div class="bg-group">
            <div>
                <img src="~/images/groups/@item.Img" />
            </div>
            <span>@item.GroupName</span>
        </div>
        </a>
    }
    
</div>
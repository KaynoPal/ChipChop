@model Factor
@{
    ViewData["Title"] = "سبد خرید";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div style="margin-top:50px !important;" class="col-md-8 m-auto border shadow-sm rounded-3 p-2 text-white">
    <h1 style="text-align:center;">سبد خرید شما</h1>
    <hr />

    <div class="col-12 text-white">
        @{
            if (Model is not null && Model.Details.Count > 0)
            {
                foreach (var item in Model.Details)
                {
                    <h6>@item.Content.Name</h6>
                    <a>قیمت » @item.Content.price</a>
                    <a>تعداد سفارش » @item.DetailCount</a>

                    <hr />
                }

                <div>
                    <a asp-controller="chip" asp-action="PreShoppingPay" class=" btn btn-warning">تکمیل فرایند خرید</a>
                </div>
            }
            else
            {
                <h4 class="alert alert-info ">سبد خرید شما خالی است</h4>
                <h4 class="alert alert-info ">همین حالا خرید کنید</h4>
            }

        }
    </div>

</div>


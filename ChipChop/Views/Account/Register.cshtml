@model chipchop.Core.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/shared/_LoginLayout.cshtml";
}

<form asp-action="Register">
    <div class="background-space">
        <div class="SOL-part">
            <h2 style="margin:0;">ساخت حساب جدید</h2>
            <div class="input-Pos">
                <div class="form-group">
                    <a>نام کاربری</a>
                    <input asp-for="UserName" class="form-control">
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <a>رمز عبور</a>
                    <input asp-for="Password" class="form-control">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <a>تکرار رمز عبور</a>
                    <input asp-for="RePassword" class="form-control" />
                    <span asp-validation-for="RePassword" class="text-danger"></span>
                </div>
                <button>ورود به حساب</button>
                <a asp-controller="Account" asp-action="Login" style="margin-bottom: 8px;" class="links">حساب کاربری دارم</a>
            </div>
        </div>
        <img class="img" src="~/images/moien lokht.jpg">
    </div>
</form>
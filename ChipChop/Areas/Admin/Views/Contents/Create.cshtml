@model chipchop.Datalayer.Models.Content
@using chipchop.Core.Classes;

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Submit new Content</h1>

<h4>Content</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" model="" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="GroupId" class="control-label"></label>
                <select asp-for="GroupId" class ="form-control" asp-items="ViewBag.Groups"></select>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="price" class="control-label"></label>
                <textarea asp-for="price" class="form-control"></textarea>
                <span asp-validation-for="price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumberAvailable" class="control-label"></label>
                <textarea asp-for="NumberAvailable" class="form-control"></textarea>
                <span asp-validation-for="NumberAvailable" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Selloff" class="control-label"></label>
                <textarea asp-for="Selloff" class="form-control"></textarea>
                <span asp-validation-for="Selloff" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="inputImg" class="btn btn-outline-info">انتخاب تصویر</label>
                <input type="file" id="inputImg" name="imgFile" asp-for="Img" class="form-control" onchange="SelectImg(this)" hidden />
                <span asp-validation-for="Img" class="text-danger"></span>
                <img id="img-view" width="250" />
            </div>

            <div class="form-group">
                <label asp-for="SubmitDate" class="control-label"></label>
                @{
                    // var date = DateTime.Now;

                    var date = new DateTimeGen().GetPersianTime();

                }
                <input value="@date" asp-for="SubmitDate" class="form-control" readonly/>
                <span asp-validation-for="SubmitDate" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Visible" /> @Html.DisplayNameFor(model => model.Visible)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<script>
    function SelectImg(input) {
        if (input.files && input.files[0]) {
            let reader = new FileReader();
            reader.onload = (e) => {
                let imgTag = document.getElementById('img-view');
                imgTag.setAttribute('src', e.target.result);
            }

            reader.readAsDataURL(input.files[0]);
        }
    }
</script>